@model InstructorInformationManagement.Models.Instructor

@{
    ViewData["Title"] = "Delete Instructor";
}

<div class="row justify-content-center">
    <div class="col-lg-8">
        <div class="card p-4 border-danger border-opacity-25">
            <div class="d-flex justify-content-between align-items-center mb-3 border-bottom pb-2">
                <h4 class="fw-bold mb-0 text-danger">
                    <i class="fa-solid fa-triangle-exclamation me-2"></i>Delete Instructor
                </h4>
                <a asp-action="Index" class="btn btn-outline-secondary btn-sm">
                    <i class="fa-solid fa-arrow-left me-1"></i>Back to List
                </a>
            </div>

            <div class="alert alert-warning py-2 small" role="alert">
                Are you sure you want to delete this instructor record? This action cannot be undone.
            </div>

            <dl class="row mb-0">
                <dt class="col-sm-4 text-muted">@Html.DisplayNameFor(model => model.InstructorIdNumber)</dt>
                <dd class="col-sm-8 fw-semibold">@Html.DisplayFor(model => model.InstructorIdNumber)</dd>

                <dt class="col-sm-4 text-muted">@Html.DisplayNameFor(model => model.FullName)</dt>
                <dd class="col-sm-8">@Html.DisplayFor(model => model.FullName)</dd>

                <dt class="col-sm-4 text-muted">@Html.DisplayNameFor(model => model.Address)</dt>
                <dd class="col-sm-8">@Html.DisplayFor(model => model.Address)</dd>

                <dt class="col-sm-4 text-muted">@Html.DisplayNameFor(model => model.Gender)</dt>
                <dd class="col-sm-8">@Html.DisplayFor(model => model.Gender)</dd>

                <dt class="col-sm-4 text-muted">@Html.DisplayNameFor(model => model.Age)</dt>
                <dd class="col-sm-8">@Html.DisplayFor(model => model.Age)</dd>

                <dt class="col-sm-4 text-muted">@Html.DisplayNameFor(model => model.Email)</dt>
                <dd class="col-sm-8">@Html.DisplayFor(model => model.Email)</dd>

                <dt class="col-sm-4 text-muted">@Html.DisplayNameFor(model => model.Majorship)</dt>
                <dd class="col-sm-8">@Html.DisplayFor(model => model.Majorship)</dd>

                <dt class="col-sm-4 text-muted">@Html.DisplayNameFor(model => model.Designation)</dt>
                <dd class="col-sm-8">@Html.DisplayFor(model => model.Designation)</dd>

                <dt class="col-sm-4 text-muted">@Html.DisplayNameFor(model => model.BachelorDegree)</dt>
                <dd class="col-sm-8">@Html.DisplayFor(model => model.BachelorDegree)</dd>

            </dl>

            <form asp-action="Delete" method="post" class="mt-4 pt-3 border-top d-flex justify-content-end gap-2">
                <input type="hidden" asp-for="Id" />
                <button type="submit" class="btn btn-danger">
                    <i class="fa-solid fa-trash me-1"></i>Confirm Delete
                </button>
                <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
            </form>
        </div>
    </div>
</div>